#!/usr/bin/env bash
# Idea to Orbit: SessionStart hook.
# Reads docs/orbit/STATE.md in the project, if there is one, and prints context for Claude:
# the product's stage and status, and the rules that hold for the whole session.
# It only reads; it never changes a file. Output is one line of JSON for Claude Code.

set -u

project="${CLAUDE_PROJECT_DIR:-$PWD}"
state="$project/docs/orbit/STATE.md"

json_escape() {
  # Escape backslash, quote and tab, drop CR, and join lines with \n, for a JSON string.
  printf '%s' "$1" | awk 'BEGIN { ORS = "" }
    {
      gsub(/\r/, "")
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      gsub(/\t/, "\\t")
      if (NR > 1) print "\\n"
      print
    }'
}

field() {
  # The value after "- <name>:" on the first matching line, without an HTML comment.
  sed -n "s/^- $1:[[:space:]]*//p" "$state" | head -n 1 | sed 's/[[:space:]]*<!--.*//' | tr -d '\r'
}

if [ -f "$state" ]; then
  product=$(sed -n 's/^# Product state:[[:space:]]*//p' "$state" | head -n 1 | tr -d '\r')
  stage=$(field Stage)
  status=$(field Status)
  questions=$(awk '/^## Open questions/ { on = 1; next } /^## / { on = 0 }
    on && /^- / && !/^- [Nn]one/ && !/<question>/ { n++ } END { print n + 0 }' "$state")
  profile=$(field Profile)
  host=$(field "Code host")
  branch=$(field "Work branch")
  builders=$(field Builders)
  inflight=$(awk '/^## .*[Ii]n flight/ { on = 1; next } /^## / { on = 0 }
    on && /^- / && !/^- [Nn]one/ { n++ } END { print n + 0 }' "$state")
  [ -n "$stage" ] || stage="unknown"
  [ -n "$status" ] || status="unknown"
  # Products started before 0.5 have no Settings: say so, rather than state 0.4's defaults as facts.
  settings="Profile: ${profile:-startup}. Code host: ${host:-github}. Work branch: ${branch:-main}. Builders: ${builders:-subagents}. In flight: ${inflight}."
  if ! grep -q '^## Settings' "$state"; then
    settings="Settings: not set in STATE.md (assuming GitHub, main, Claude's subagents, startup profile; ask the owner and fill them in). In flight: ${inflight}."
  fi
  # Skill names: stage 7's skill is keep-running (a skill named orbit would clash with /orbit), and the
  # "idea-to-orbit:" prefix exists only when installed as a plugin; the install scripts add plain names.
  pre=""
  [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && pre="idea-to-orbit:"
  # The skill is the Stage field's first word: "ignite (catching up ...)" means the ignite skill.
  skill="${stage%%[[:space:]]*}"
  [ "$skill" = "orbit" ] && skill="keep-running"

  text="This repository is a product built with Idea to Orbit: ${product:-unnamed}.
Stage: ${stage}. Status: ${status}. Open questions: ${questions}.
${settings}

These rules hold for this whole session:
1. Before working on this product, read docs/orbit/STATE.md and use the skill for the current stage (${pre}${skill}). Follow its steps and stop at its red flags.
2. A stage starts only when the stage before it is approved in STATE.md. A gate passes only on the owner's explicit yes in this conversation; a question, a comment or silence is not a yes.
3. No production code without a failing test that you ran and watched fail first. This holds in every stage, for every change, however small or urgent.
4. When something breaks, use ${pre}debug and find the cause before changing code.
5. Before saying that anything is done, fixed, passing or deployed, run the check and show its output (${pre}verify).
6. If the owner asks to skip a step, say which rule it breaks and what could go wrong, then follow the owner's decision and record it as a Skipped rule row in JOURNAL.md, with a line in the STATE.md log.
7. Use the Settings in STATE.md (code host, branches, builders, test commands) instead of assuming GitHub, main or subagents. New work on a product past build goes through a lane (feature, fix or hotfix, see /orbit), listed under In flight.
8. Record every change, every fix made in review and every roadblock (cause, how it was cleared, the lesson) in docs/orbit/JOURNAL.md, or the journal STATE.md points to.
9. Load the skill before acting, not only its rules from memory: ${pre}verify before any status, report or message that says something works or passes; ${pre}review before any merge; ${pre}learn when the same kind of problem comes back or the owner asks for a lesson; and the stage's skill for any stage work.
10. A model setting (temperature, top_p, tools, a new model ID) gets one real call before a test pins it: a test against a stub passes even when the real model refuses the setting.
11. A request to add, improve, ramp up or 'make it like' something on a built or live product is a feature lane: use ${pre}ignite first (requirements with acceptance checks, out of scope, the lane under In flight, the owner's yes) before any build plan or list of steps."
else
  text="Idea to Orbit is installed. This repository has no docs/orbit/STATE.md, so no product is in progress here. If the owner wants to start or continue a product, use /orbit. If they describe a new product idea, offer to start the ignite stage before writing any code."
fi

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$(json_escape "$text")"
